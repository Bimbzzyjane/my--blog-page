<%- include("partials/header.ejs") %>



<section class="posts-section">
    <div class="posts-header">
        <div>
            <h2>All Posts</h2>
            <p>Read your latest blog posts📚</p>
        </div>
        <div class="search">
            <input type="text" placeholder="Search posts..." id="searchPosts">
            <button type="button">🔍</button>
        </div>
    </div>

    <div class="posts-container" id="posts">
        <% posts.forEach(post => { %>
            <article class="post-card">
                <div class="post-content">    
                    <h3><%= post.title %></h3>
                    <p class="post-date">
                        <%= post.date %>
                    </p>
                    <p><%= post.content %></p>
                </div>

                <div class="post-actions">
                    <a href="/posts/<%= post.id %>/edit">Edit</a>
                    <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                        <button >
                            Delete
                        </button>
                    </form>
                    
                </div>
            </article>
        <% }); %>

