<%- include("partials/header.ejs") %>

<section class="hero">

    <div class="hero-content">
        <h1>Share your thoughts.</br><span class="shade">Inspire </span>the world.</h1>
        <p>
            Create, share and discover ideas</br>through beautiful blog posts.
        </p>
        <a href="/posts/new" class="new-post-btn" id="hero-btn">Create New Posts</a>
    </div>

    <div class="hero-img">
        <img src="/images/hero.png" alt="Laptop-image">
    </div>

</section>

<section class="posts-section">
    <div class="posts-header">
        <div>
            <h2>All Posts</h2>
            <p>Read your latest blog posts📚</p>
        </div>

    </div>

    <div class="posts-container" id="posts">
        <% posts.forEach(post => { %>
            <article class="post-card">
                <div class="post-content">    
                    <h3><%= post.title %></h3>
                    <p class="post-date">
                        <%= post.date %>
                    </p>
                    <p><%= post.content %></p>
                </div>

                <div class="post-actions">
                    <a href="/posts/<%= post.id %>/edit">Edit</a>
                    <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                        <button >
                            Delete
                        </button>
                    </form>
                    
                </div>
            </article>
        <% }); %>
    </div>
</section>

<%- include("partials/footer.ejs") %>