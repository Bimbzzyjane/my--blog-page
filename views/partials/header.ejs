<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Janet's Blog</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <header>
        
        <nav class="navbar">
            <a href="/" class="logo">
                <img src="/images/logo.png" alt="MyBlog Logo">
            </a>
            <div class="nav-links">
                <a href="/" class="active">Home</a>
                <a href="/about">About</a>
                <a href="/#posts">My Posts</a>
            </div>
            <div class="nav-right">
                <span class="user-greeting">Hello, User</span>
                <a href="/posts/new" class="new-post-btn">
                    New Post <span>+</span>
                </a>

            </div>
                 
                
        </nav>
    </header>
<main class="container">
    <section class="hero">
    
    <div class="hero-content">
        <h1>Share your thoughts.</br><span class="shade">Inspire </span>the world.</h1>
        <p>
            Create, share and discover ideas</br>through beautiful blog posts.
        </p>
        <a href="/posts/new" class="new-post-btn" id="hero-btn">Create New Posts</a>
    </div>

    <div class="hero-img">
        <img src="/images/hero.png" alt="Laptop-image">
    </div>
    

</section>